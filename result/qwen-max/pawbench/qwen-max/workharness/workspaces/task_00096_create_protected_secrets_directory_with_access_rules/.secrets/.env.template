# This is a template for environment variables that should be set in a .env file.
# DO NOT store real values here; this file is only for reference and should never be committed to version control.

# Database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=yourpasswordhere

# API keys
API_KEY=yourapikeyhere

# OAuth secrets
OAUTH_CLIENT_ID=yourclientidhere
OAUTH_CLIENT_SECRET=yourclientsecrethere

# SSH keys
SSH_PRIVATE_KEY_PATH=/path/to/private/key