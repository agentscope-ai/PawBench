+    def __init__(
+        self,
+        *args,
+        multi_agent: bool = False,
+        multi_agent_max_threads: int | None = None,
+        **kwargs,
+    ):
+        # ── Multi-agent / sub-agent delegation ─────────────────────────────────
+        # Codex CLI ships multi-agent delegation as the under-development
+        # ``multi_agent_v2`` feature (enabled like ``--enable unified_exec``),
+        # configured via the ``[multi_agent_v2]`` table. The delegation mode
+        # (proactive vs explicit) is an app-server/thread-level parameter and is
+        # not a config.toml key in `codex exec`, so headless runs just enable the
+        # feature and (optionally) cap concurrent worker threads.
+        self._multi_agent = bool(multi_agent)
+        self._multi_agent_max_threads = (
+            int(multi_agent_max_threads) if multi_agent_max_threads else None
+        )
+        super().__init__(*args, **kwargs)
+
+    def _build_multi_agent_args(self) -> str:
+        """Return the ``--enable multi_agent_v2 …`` fragment, or ``""`` if off."""
+        if not self._multi_agent:
+            return ""
+        parts = [
+            "--enable multi_agent_v2",
+            # The feature is flagged under-development and prints a warning as a
+            # JSON error item; suppress it so it doesn't pollute the transcript.
+            "-c suppress_unstable_features_warning=true",
+        ]
+        if self._multi_agent_max_threads:
+            parts.append(
+                "-c multi_agent_v2.max_concurrent_threads_per_session="
+                f"{self._multi_agent_max_threads}"
+            )
+        return " ".join(parts)
