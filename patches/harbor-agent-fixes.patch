+    def _build_subagents_flag(self) -> str:
+        """Return a shell-safe ``--agents '<json>'`` flag, or ``""`` if none.
+
+        Serializes ``self._subagents`` into the JSON object claude-code expects
+        (keyed by sub-agent name), then shell-quotes it so the whole JSON is a
+        single argument regardless of embedded spaces/quotes.
+        """
+        if not self._subagents:
+            return ""
+        import json as _json
+        import shlex as _shlex
+
+        agents_obj: dict[str, dict] = {}
+        for spec in self._subagents:
+            if not isinstance(spec, dict):
+                continue
+            name = str(spec.get("name") or "").strip()
+            if not name:
+                continue
+            entry = {k: v for k, v in spec.items() if k != "name"}
+            agents_obj[name] = entry
+        if not agents_obj:
+            return ""
+        return "--agents " + _shlex.quote(_json.dumps(agents_obj, ensure_ascii=False))
+
